---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageType?: 'profile' | 'collection' | 'article' | 'webpage';
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; path: string }>;
  keywords?: string[];
  headline?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  topics?: string[];
  downloads?: Array<{ name: string; url: string; format: string }>;
  collectionItems?: Array<{ name: string; path: string; description: string }>;
}

const {
  title = 'Hongyi (Tom) Chen | Home',
  description = 'Hongyi (Tom) Chen (陈洪熠) is a Data Science undergraduate at CUHK-Shenzhen, former UC Berkeley visiting student, and MLE Intern.',
  image = '/og.png',
  pageType = 'webpage',
  noindex = false,
  breadcrumbs = [],
  keywords = [],
  headline = title,
  publishedTime,
  modifiedTime,
  topics = [],
  downloads = [],
  collectionItems = [],
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? Astro.url.origin;
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const personImageUrl = new URL('/me1.jpg', siteUrl).toString();
const identityName = pageType === 'profile' ? 'Hongyi Chen' : 'Hongyi (Tom) Chen';
const identityAlternateNames = [
  pageType === 'profile' ? 'Hongyi (Tom) Chen' : 'Hongyi Chen',
  'Tom Chen',
  'Hongyi Tom Chen',
  '陈洪熠',
];
const websiteStructuredData = {
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: identityName,
  alternateName: identityAlternateNames,
  inLanguage: 'en',
};
const pageStructuredData = {
  '@type': pageType === 'profile'
    ? 'ProfilePage'
    : pageType === 'collection'
      ? 'CollectionPage'
      : pageType === 'article'
        ? 'Article'
        : 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: title,
  description,
  ...(pageType === 'profile' && modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
  ...(keywords.length > 0 ? { keywords } : {}),
  ...(pageType === 'article' ? {
    headline,
    image: imageUrl,
    mainEntityOfPage: pageUrl,
    inLanguage: 'en',
    articleSection: 'Course Notes',
    isAccessibleForFree: true,
    ...(topics.length > 0 ? {
      about: topics.map((name) => ({ '@type': 'Thing', name })),
    } : {}),
    ...(downloads.length > 0 ? {
      encoding: downloads.map((download) => ({
        '@type': 'MediaObject',
        name: download.name,
        contentUrl: new URL(download.url, siteUrl).toString(),
        encodingFormat: download.format,
      })),
    } : {}),
    author: {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Hongyi (Tom) Chen',
      url: new URL('/about/', siteUrl).toString(),
    },
    ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
    ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
  } : {}),
  ...(pageType === 'collection' && collectionItems.length > 0 ? {
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: collectionItems.length,
      itemListElement: collectionItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'Article',
          name: item.name,
          url: new URL(item.path, siteUrl).toString(),
          description: item.description,
        },
      })),
    },
  } : {}),
  isPartOf: { '@id': `${siteUrl}#website` },
};
const personStructuredData = {
  '@type': 'Person',
  '@id': `${siteUrl}#person`,
  name: identityName,
  alternateName: identityAlternateNames,
  ...(pageType === 'profile' ? {
    givenName: 'Hongyi',
    familyName: 'Chen',
    description: 'Hongyi Chen (Tom Chen), a Data Science undergraduate at CUHK-Shenzhen and former UC Berkeley visiting student working in medical AI and machine learning.',
  } : {}),
  url: siteUrl,
  image: personImageUrl,
  email: 'mailto:tomchen0417@gmail.com',
  jobTitle: 'MLE Intern',
  worksFor: {
    '@type': 'Organization',
    name: 'Cardinal Operations',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Shanghai',
      addressCountry: 'CN',
    },
  },
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'The Chinese University of Hong Kong, Shenzhen',
    alternateName: [
      'CUHK-Shenzhen',
      'CUHKSZ',
      '香港中文大学（深圳）',
      '香港中文大学深圳',
      '港中深',
      'GZS',
      'gzs',
    ],
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'University of California, Berkeley',
    alternateName: 'UC Berkeley',
  },
  sameAs: [
    'https://github.com/TomChen01',
    'https://linkedin.com/in/tomchen17',
  ],
  knowsAbout: [
    'Medical Artificial Intelligence',
    'Machine Learning',
    'Large Language Models',
    'Model Editing',
    'Quantitative Finance',
    'Data Science',
    'Data Analysis',
  ],
};
const breadcrumbsStructuredData = breadcrumbs.length > 0 ? {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((breadcrumb, position) => ({
    '@type': 'ListItem',
    position: position + 1,
    name: breadcrumb.name,
    item: new URL(breadcrumb.path, siteUrl).toString(),
  })),
} : null;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    websiteStructuredData,
    pageType === 'profile'
      ? { ...pageStructuredData, mainEntity: { '@id': `${siteUrl}#person` } }
      : pageStructuredData,
    ...(pageType === 'profile' || pageType === 'article' ? [personStructuredData] : []),
    ...(breadcrumbsStructuredData ? [breadcrumbsStructuredData] : []),
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/dybala-avatar.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="ccYNUI-sljnTWZFekqqHm9KhFPlyqYsmMNRwgrmVCHA" />
    <meta name="description" content={description} />
    <meta name="author" content={identityName} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content={pageType === 'profile' ? 'profile' : pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={identityName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Hongyi (Tom) Chen" />
    {pageType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {pageType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Hongyi (Tom) Chen" />
    <meta name="twitter:url" content={pageUrl} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Signika:wght@300..700&display=swap" rel="stylesheet">
    <style is:global>
      /* Signika Font */
      :root {
        --font-sans: 'Signika', sans-serif;
      }
      body {
        font-family: var(--font-sans);
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Navigation />
    <main id="main-content" tabindex="-1" class="relative flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>
    <footer class="px-4 py-8 sm:py-12 text-center text-sm text-gray-400 border-t border-gray-100 mt-auto">
      <p>&copy; {new Date().getFullYear()} Hongyi (Tom) Chen. All rights reserved.</p>
    </footer>
    <script>
      const skipLink = document.querySelector<HTMLAnchorElement>('.skip-link');
      const mainContent = document.querySelector<HTMLElement>('#main-content');

      skipLink?.addEventListener('click', () => {
        mainContent?.focus();
      });
    </script>
  </body>
</html>
