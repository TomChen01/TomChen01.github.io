---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).filter((project) => project.data.published).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="AI & Data Science Projects | Hongyi (Tom) Chen"
	description="Selected AI, machine learning, data systems, and product engineering projects by Hongyi (Tom) Chen."
	pageType="collection"
>
	<div class="max-w-4xl mx-auto">
		<header class="mb-12 text-center md:text-left">
			<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 mb-4">Projects</h1>
			<p class="text-lg sm:text-xl text-gray-600 max-w-2xl">
				Selected work in AI, machine learning, data systems, and product engineering.
			</p>
		</header>

		<div class="divide-y divide-gray-100 border-y border-gray-100">
			{projects.map((project) => (
				<a href={`/projects/${project.id}/`} class="group flex flex-col gap-3 py-5 sm:flex-row sm:items-center sm:justify-between">
					<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
						<h2 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600">{project.data.title}</h2>
						<time datetime={project.data.publishDate.toISOString()} class="text-sm text-gray-400 font-mono whitespace-nowrap">{project.data.date}</time>
					</div>
					<span class="inline-flex shrink-0 items-center text-sm font-medium text-blue-600">View project →</span>
				</a>
			))}
		</div>
	</div>
</BaseLayout>
