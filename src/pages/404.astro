---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Hongyi (Tom) Chen"
  description="The requested page could not be found."
  noindex={true}
>
  <section class="mx-auto max-w-2xl py-12 text-center sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-700">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-lg text-gray-600">The page you requested is unavailable or may have moved.</p>
    <nav class="mt-8 flex flex-wrap justify-center gap-3" aria-label="Helpful links">
      <a href="/" class="inline-flex min-h-11 items-center rounded-lg bg-gray-900 px-4 py-2 font-medium text-white hover:bg-blue-600 transition-colors">Home</a>
      <a href="/projects" class="inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-800 hover:border-blue-600 hover:text-blue-600 transition-colors">Projects</a>
      <a href="/notes" class="inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-4 py-2 font-medium text-gray-800 hover:border-blue-600 hover:text-blue-600 transition-colors">Notes</a>
    </nav>
  </section>
</BaseLayout>
