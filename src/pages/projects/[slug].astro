---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => project.data.published);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, date, publishDate, tags, repoUrl } = project.data;
---

<BaseLayout
  title={`${title} | Hongyi (Tom) Chen`}
  description={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects/' },
    { name: title, path: `/projects/${project.id}/` },
  ]}
>
  <article class="max-w-4xl mx-auto space-y-8">
    <header class="space-y-5">
      <a href="/projects/" class="inline-flex min-h-11 items-center text-sm text-gray-500 hover:text-blue-600 transition-colors">← All projects</a>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight text-gray-900">{title}</h1>
      <time datetime={publishDate.toISOString()} class="block text-sm text-gray-500 font-mono">{date}</time>
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-500">#{tag}</span>)}
      </div>
      <p class="text-base sm:text-lg leading-relaxed text-gray-600">{description}</p>
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">View repository ↗</a>
      )}
    </header>

    <div class="project-content border-t border-gray-200 pt-8">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-content :global(figure) { margin: 0 0 2rem; }
  .project-content :global(figure img) { display: block; width: 100%; height: auto; }
  .project-content :global(figcaption) {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6b7280;
  }
  .project-content :global(figcaption a) { color: #2563eb; text-decoration: underline; }
  .project-content :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: 1.4rem;
    font-weight: 600;
    color: #111827;
  }
  .project-content :global(h2:first-child) { margin-top: 0; }
  .project-content :global(p), .project-content :global(ol) {
    margin-bottom: 1rem;
    line-height: 1.8;
    color: #4b5563;
  }
  .project-content :global(ol) { padding-left: 1.5rem; list-style: decimal; }
  .project-content :global(li) { margin-bottom: 0.5rem; }
</style>
