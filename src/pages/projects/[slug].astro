---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((project) => project.data.published);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<'projects'> };
const { project } = Astro.props;
const { title, description, date, publishDate, tags, image, repoUrl } = project.data;
---

<BaseLayout
  title={`${title} | Hongyi (Tom) Chen`}
  description={description}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Projects', path: '/projects/' },
    { name: title, path: `/projects/${project.id}/` },
  ]}
>
  <article class="max-w-4xl mx-auto space-y-8">
    <header class="space-y-5">
      <a href="/projects/" class="inline-flex min-h-11 items-center text-sm text-gray-500 hover:text-blue-600 transition-colors">← All projects</a>
      <h1 class="text-3xl sm:text-4xl font-bold leading-tight text-gray-900">{title}</h1>
      <time datetime={publishDate.toISOString()} class="block text-sm text-gray-500 font-mono">{date}</time>
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => <span class="rounded bg-gray-100 px-2 py-1 text-xs text-gray-500">#{tag}</span>)}
      </div>
      <p class="text-base sm:text-lg leading-relaxed text-gray-600">{description}</p>
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">View repository ↗</a>
      )}
    </header>
    {image && (
      <figure class="space-y-3">
        <a href={image.src} target="_blank" rel="noopener noreferrer">
          <img src={image.src} alt={image.alt} decoding="async" class="w-full h-auto rounded-lg border border-gray-100 bg-white" />
        </a>
        <figcaption class="text-xs leading-relaxed text-gray-500">
          {image.caption}{' '}
          <a href={image.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-blue-600">Source</a>
        </figcaption>
      </figure>
    )}
  </article>
</BaseLayout>
