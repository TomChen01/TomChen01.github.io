---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => note.data.published);

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

type Props = {
  note: CollectionEntry<'notes'>;
};

const { note } = Astro.props;
const { Content } = await render(note);

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={`${note.data.seoTitle ?? note.data.title} | Hongyi (Tom) Chen`}
  description={note.data.description}
  pageType="article"
  keywords={note.data.seoKeywords}
  headline={note.data.title}
  publishedTime={note.data.pubDate}
  modifiedTime={note.data.updatedDate}
  topics={note.data.tags}
  downloads={[
    ...(note.data.pdfUrl ? [{ name: `${note.data.title} PDF`, url: note.data.pdfUrl, format: 'application/pdf' }] : []),
    ...(note.data.sourceUrl ? [{ name: `${note.data.title} LaTeX source`, url: note.data.sourceUrl, format: 'application/x-tex' }] : []),
  ]}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Notes', path: '/notes/' },
    { name: note.data.title, path: `/notes/${note.id}/` },
  ]}
>
  <article class="max-w-3xl mx-auto space-y-8">
    <header class="space-y-6">
      <a href="/notes/" class="inline-flex min-h-11 items-center text-sm text-gray-500 hover:text-blue-600 transition-colors">
        ← All notes
      </a>
      <div class="space-y-3">
        <p class="text-sm font-semibold tracking-wide text-blue-700">{note.data.courseCode}</p>
        <h1 class="text-3xl sm:text-4xl font-bold leading-tight text-gray-900">{note.data.courseName}</h1>
        <p class="text-base text-gray-600">{note.data.institution} · {note.data.term}</p>
      </div>
    </header>
    {(note.data.pdfUrl || note.data.sourceUrl) && (
      <section aria-label="Downloads" class="border-b border-gray-200 pb-8">
        <div class="flex flex-wrap gap-3">
          {note.data.pdfUrl && (
            <a
              href={note.data.pdfUrl}
              class="inline-flex min-h-11 items-center rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-600 transition-colors"
            >
              Download PDF
            </a>
          )}
          {note.data.sourceUrl && (
            <a
              href={note.data.sourceUrl}
              class="inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-medium text-gray-800 hover:border-blue-600 hover:text-blue-600 transition-colors"
            >
              Download LaTeX source
            </a>
          )}
        </div>
      </section>
    )}

    <div class="note-content text-base leading-relaxed text-gray-700">
      <Content />
    </div>

    <footer class="border-t border-gray-200 pt-5 space-y-3 text-sm text-gray-500">
      <p>
        By <a href="/about/" rel="author" class="font-medium hover:text-blue-600">Hongyi (Tom) Chen</a>
        <span aria-hidden="true"> · </span>
        Updated <time datetime={(note.data.updatedDate ?? note.data.pubDate).toISOString()}>{dateFormat.format(note.data.updatedDate ?? note.data.pubDate)}</time>
      </p>
      <p>Unofficial course materials; content may contain errors.</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .note-content :global(h2) {
    margin-bottom: 1rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827;
  }
  .note-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .note-content :global(li + li) {
    margin-top: 0.75rem;
  }
  .note-content :global(li::marker) {
    color: #9ca3af;
  }
</style>
