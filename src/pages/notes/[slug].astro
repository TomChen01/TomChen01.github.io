---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => note.data.published);

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

type Props = {
  note: CollectionEntry<'notes'>;
};

const { note } = Astro.props;
const { Content } = await render(note);
const headline = `${note.data.courseCode}: ${note.data.courseName} Notes`;
---

<BaseLayout
  title={`${note.data.seoTitle ?? `${headline} | ${note.data.institution}`} | Hongyi Chen`}
  description={note.data.description}
  pageType="article"
  keywords={note.data.seoKeywords}
  headline={headline}
  publishedTime={note.data.pubDate}
  modifiedTime={note.data.updatedDate}
  topics={note.data.tags}
  downloads={[
    ...(note.data.pdfUrl ? [{ name: `${headline} PDF`, url: note.data.pdfUrl, format: 'application/pdf' }] : []),
    ...(note.data.sourceUrl ? [{ name: `${headline} LaTeX source`, url: note.data.sourceUrl, format: 'application/x-tex' }] : []),
  ]}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Notes', path: '/notes/' },
    { name: headline, path: `/notes/${note.id}/` },
  ]}
>
  <article class="max-w-3xl mx-auto space-y-8">
    <header class="space-y-6">
      <a href="/notes/" class="inline-flex min-h-11 items-center text-sm text-gray-500 hover:text-blue-600 transition-colors">
        ← All notes
      </a>
      <div class="space-y-3">
        <p class="text-sm font-semibold tracking-wide text-blue-700">{note.data.courseCode}</p>
        <h1 class="text-3xl sm:text-4xl font-bold leading-tight text-gray-900">{headline}</h1>
        <p class="text-base text-gray-600">{note.data.institution} · {note.data.term}</p>
        <p class="text-base leading-relaxed text-gray-600">{note.data.description}</p>
      </div>
    </header>
    {(note.data.pdfUrl || note.data.sourceUrl) && (
      <section aria-label="Downloads" class="border-b border-gray-200 pb-8">
        <div class="flex flex-wrap gap-3">
          {note.data.pdfUrl && (
            <a
              href={note.data.pdfUrl}
              class="inline-flex min-h-11 items-center rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-600 transition-colors"
            >
              Read {note.data.courseCode} notes (PDF)
            </a>
          )}
          {note.data.sourceUrl && (
            <a
              href={note.data.sourceUrl}
              download
              class="inline-flex min-h-11 items-center rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-medium text-gray-800 hover:border-blue-600 hover:text-blue-600 transition-colors"
            >
              LaTeX source
            </a>
          )}
        </div>
      </section>
    )}

    <div class="note-content text-base leading-relaxed text-gray-700">
      <Content />
    </div>

    <footer class="border-t border-gray-200 pt-5 space-y-1 text-sm text-gray-500">
      <p>
        Notes by <a href="/about/" rel="author" class="font-medium hover:text-blue-600">Hongyi (Tom) Chen</a>
      </p>
      <p>Unofficial course materials; content may contain errors.</p>
    </footer>
  </article>
</BaseLayout>

<style>
  .note-content :global(h2) {
    margin-bottom: 1rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #111827;
  }
  .note-content :global(ul) {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }
  .note-content :global(strong) {
    display: block;
    margin-bottom: 0.25rem;
    font-weight: 600;
    color: #111827;
  }
  @media (min-width: 640px) {
    .note-content :global(ul) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 2rem;
    }
  }
</style>
