---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const notes = (await getCollection('notes')).filter((note) => note.data.published);

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

type Props = {
  note: CollectionEntry<'notes'>;
};

const { note } = Astro.props;
const { Content } = await render(note);

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout
  title={`${note.data.seoTitle ?? note.data.title} | Hongyi (Tom) Chen`}
  description={note.data.description}
  pageType="article"
  keywords={note.data.seoKeywords}
  headline={note.data.title}
  publishedTime={note.data.pubDate}
  modifiedTime={note.data.updatedDate}
  topics={note.data.tags}
  downloads={[
    ...(note.data.pdfUrl ? [{ name: `${note.data.title} PDF`, url: note.data.pdfUrl, format: 'application/pdf' }] : []),
    ...(note.data.sourceUrl ? [{ name: `${note.data.title} LaTeX source`, url: note.data.sourceUrl, format: 'application/x-tex' }] : []),
  ]}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Notes', path: '/notes/' },
    { name: note.data.title, path: `/notes/${note.id}/` },
  ]}
>
  <article class="max-w-3xl mx-auto space-y-10">
    <header class="border-b border-gray-100 pb-8 space-y-4">
      <a href="/notes/" class="text-sm text-gray-500 hover:text-blue-600 transition-colors">
        Back to notes
      </a>
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 break-words">{note.data.title}</h1>
        <p class="text-sm text-gray-400">
          By <a href="/about/" rel="author" class="font-medium text-gray-500 hover:text-blue-600">Hongyi (Tom) Chen</a>
          <span aria-hidden="true"> · </span>
          <time datetime={note.data.pubDate.toISOString()}>{dateFormat.format(note.data.pubDate)}</time>
          {note.data.updatedDate && (
            <>
              <span aria-hidden="true"> · </span>
              Updated <time datetime={note.data.updatedDate.toISOString()}>{dateFormat.format(note.data.updatedDate)}</time>
            </>
          )}
        </p>
        <p class="text-lg sm:text-xl text-gray-600">{note.data.description}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        {note.data.tags.map((tag) => (
          <span class="text-xs text-gray-500 bg-gray-100 rounded px-2 py-1">#{tag}</span>
        ))}
      </div>
    </header>

    <div class="prose prose-gray max-w-none">
      <Content />
    </div>

    <aside class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600" aria-label="Course note disclaimer">
      Unofficial course materials; content may contain errors.
    </aside>

    {(note.data.pdfUrl || note.data.sourceUrl) && (
      <section class="border border-gray-200 rounded-lg p-5 space-y-4">
        <h2 class="text-lg font-semibold text-gray-900">Downloads</h2>
        <div class="flex flex-wrap gap-3">
          {note.data.pdfUrl && (
            <a
              href={note.data.pdfUrl}
              class="inline-flex items-center rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-blue-600 transition-colors"
            >
              Download PDF
            </a>
          )}
          {note.data.sourceUrl && (
            <a
              href={note.data.sourceUrl}
              class="inline-flex items-center rounded border border-gray-300 px-4 py-2 text-sm font-medium text-gray-800 hover:border-blue-600 hover:text-blue-600 transition-colors"
            >
              Download LaTeX source
            </a>
          )}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
