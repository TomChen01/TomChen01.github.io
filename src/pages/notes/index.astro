---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = (await getCollection('notes')).filter((note) => note.data.published);
const getTermYear = (title: string) => {
  const match = title.match(/\((\d{2})\s/);

  return match ? Number(match[1]) : 0;
};

const sortedNotes = allNotes.sort((a, b) => {
  const yearDiff = getTermYear(b.data.title) - getTermYear(a.data.title);
  if (yearDiff !== 0) return yearDiff;

  return a.data.title.localeCompare(b.data.title);
});

const groupLabel = (note: typeof sortedNotes[number]) => `${note.data.institution} · ${note.data.term}`;
const groups = [...new Set(sortedNotes.map(groupLabel))].map((label) => ({
  label,
  notes: sortedNotes.filter((note) => groupLabel(note) === label),
}));
---

	<BaseLayout
	title="Course Notes: AI, Machine Learning & Math | Hongyi Chen"
	description="Free PDF course notes for UC Berkeley CS188 and CS C182, plus CUHK-Shenzhen machine learning, optimization, and stochastic processes, by Hongyi (Tom) Chen."
  pageType="collection"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Course Notes', path: '/notes/' },
  ]}
	keywords={[
		'陈洪熠 课程笔记',
		'陈洪熠 港中深 笔记',
		'港中深 课程笔记',
		'香港中文大学深圳 课程笔记',
		'香港中文大学（深圳） 课程笔记',
		'cuhksz course notes',
		'gzs course notes',
	]}
  collectionItems={sortedNotes.map((note) => ({
    name: `${note.data.courseCode}: ${note.data.courseName} Notes`,
    path: `/notes/${note.id}/`,
    description: note.data.description,
  }))}
>
  <div class="max-w-3xl mx-auto space-y-10">
    <header class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">Course Notes</h1>
      <p class="text-base leading-relaxed text-gray-600">Course notes from UC Berkeley and CUHK-Shenzhen, with free PDFs and LaTeX source where available.</p>
    </header>

    {groups.map((group) => (
      <section aria-label={group.label}>
        <h2 class="border-b border-gray-200 pb-3 text-sm font-semibold text-gray-600">{group.label}</h2>
        <ul class="divide-y divide-gray-200">
          {group.notes.map((note) => (
            <li class="flex flex-col gap-2 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
              <a href={`/notes/${note.id}/`} class="group min-w-0 flex-1 space-y-1">
                <span class="block text-sm font-semibold tracking-wide text-gray-500">{note.data.courseCode}</span>
                <h3 class="text-lg font-semibold text-gray-900 group-hover:text-blue-600">{note.data.courseName} Notes</h3>
              </a>
              <div class="flex shrink-0 items-center gap-4 text-sm font-medium">
                {note.data.pdfUrl && <a href={note.data.pdfUrl} aria-label={`${note.data.courseCode} PDF`} class="inline-flex min-h-11 items-center text-blue-700 hover:underline underline-offset-4">PDF</a>}
                {note.data.sourceUrl && <a href={note.data.sourceUrl} download aria-label={`${note.data.courseCode} LaTeX source`} class="inline-flex min-h-11 items-center text-gray-600 hover:text-blue-700 hover:underline underline-offset-4">LaTeX</a>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
