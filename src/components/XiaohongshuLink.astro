<div class="xiaohongshu-link relative inline-flex">
  <a href="https://xhslink.cn/o/6stE2k4RyKW" target="_blank" rel="me noopener noreferrer" class="inline-flex items-center gap-2 px-4 sm:px-6 py-2 bg-white border border-gray-900 text-gray-900 font-medium rounded-lg hover:bg-gray-100 transition-colors">
    <span lang="zh-CN">小红书</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7M7 7h10v10" /></svg>
  </a>
  <div class="tree-preview" hidden aria-hidden="true">
    <iframe
      data-src="https://tree.icqr.com/s/MTBodHRwczovL3hoc2xpbmsuY24vby82c3RFMms0UnlLVw"
      title="Xiaohongshu summer QR tree by ICQR"
      width="400"
      height="600"
      tabindex="-1"
      referrerpolicy="no-referrer"
      sandbox="allow-scripts allow-same-origin"
    ></iframe>
    <span class="tree-credit">Summer · ICQR</span>
  </div>
</div>

<style>
  .tree-preview {
    position: absolute;
    bottom: calc(100% + 0.75rem);
    right: 0;
    z-index: 50;
    width: 240px;
    height: 280px;
    overflow: hidden;
    pointer-events: none;
    border-radius: 0.75rem;
    background: #f6f1e7;
    box-shadow: 0 12px 36px rgb(17 24 39 / 18%);
  }
  .tree-preview::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 28px;
    z-index: 1;
    background: #f6f1e7;
  }
  .tree-preview iframe {
    width: 400px;
    max-width: none;
    height: 600px;
    border: 0;
    transform: translateY(-20px) scale(0.6);
    transform-origin: top left;
  }
  .tree-credit {
    position: absolute;
    inset: auto 0 0;
    padding: 12px;
    background: #f6f1e7;
    color: #57534e;
    font-size: 12px;
    text-align: center;
  }
</style>

<script>
  const social = document.querySelector<HTMLElement>('.xiaohongshu-link');
  const link = social?.querySelector('a');
  const preview = social?.querySelector<HTMLElement>('.tree-preview');
  const frame = preview?.querySelector('iframe');
  const canPreview = window.matchMedia('(min-width: 640px) and (hover: hover) and (pointer: fine)');

  function showTree() {
    if (!canPreview.matches || !preview || !frame) return;
    preview.hidden = false;
    if (!frame.hasAttribute('src')) frame.src = frame.dataset.src!;
  }

  function hideTree() {
    if (!preview || !frame) return;
    preview.hidden = true;
    frame.removeAttribute('src');
  }

  social?.addEventListener('pointerenter', showTree);
  social?.addEventListener('pointerleave', hideTree);
  link?.addEventListener('focus', showTree);
  link?.addEventListener('blur', hideTree);
  link?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') hideTree();
  });
</script>
